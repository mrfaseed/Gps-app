<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GPSMapCameraApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BEBEBE</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorPrimary">#2196F3</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>

    <style name="Theme.GPSMapCameraApp" parent="Base.Theme.GPSMapCameraApp" />

    <!-- Apple-style Clean White Settings Theme -->
    <style name="Theme.GPSMapCameraApp.Settings" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:colorBackground">#F2F2F7</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1C1C1E</item>
        <item name="colorPrimary">#007AFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>