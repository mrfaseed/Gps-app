<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/satellite_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="0dp">

    <!-- Mini Satellite Map Card (Left) -->
    <FrameLayout
        android:id="@+id/satellite_map_card"
        android:layout_width="96dp"
        android:layout_height="96dp">

        <!-- Anti-aliased rounded satellite map image -->
        <ImageView
            android:id="@+id/satellite_map_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Marker Pin -->
        <ImageView
            android:id="@+id/satellite_map_pin"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/pin_location_icon"
            android:visibility="gone" />

        <!-- High-tech "SATELLITE" Chip Overlay -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="5dp"
            android:background="@drawable/bg_gps_pill"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="SATELLITE"
            android:textColor="#00E5FF"
            android:textSize="6.5sp"
            android:textStyle="bold" />

        <!-- Frosted glass border overlay with 14dp rounded corners -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_stroke" />

    </FrameLayout>

    <!-- Satellite Details Glass Card (Right) -->
    <FrameLayout
        android:id="@+id/satellite_details_card"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <!-- Short Address (Title) -->
            <TextView
                android:id="@+id/satellite_short_address_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Location Acquired"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Full Address (Subtitle) -->
            <TextView
                android:id="@+id/satellite_full_address_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Acquiring address..."
                android:textColor="#C9D1D9"
                android:textSize="8.5sp" />

            <!-- Lat / Long with Electric Cyan Accent -->
            <TextView
                android:id="@+id/satellite_lat_long_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Lat -- Long --"
                android:textColor="#00E5FF"
                android:textSize="8sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Telemetry Metrics Row with Cyan Accents & Bullets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/satellite_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/09/2026"
                    android:textColor="@color/white"
                    android:textSize="7.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="7.5sp" />

                <TextView
                    android:id="@+id/satellite_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:44 PM"
                    android:textColor="@color/white"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="7.5sp" />

                <TextView
                    android:id="@+id/satellite_altitude_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14.7 m"
                    android:textColor="#00E5FF"
                    android:textSize="7.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="7.5sp" />

                <TextView
                    android:id="@+id/satellite_accuracy_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±32.0 m"
                    android:textColor="#00E5FF"
                    android:textSize="7.5sp" />
            </LinearLayout>

            <!-- Modern Branding Footer -->
            <TextView
                android:id="@+id/satellite_branding_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Captured with Simatrix GPS"
                android:textColor="#88FFFFFF"
                android:textSize="7sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
