<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/minimal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- Top Title / Short Address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_stamp_pin"
            app:tint="#FFD54F" />

        <TextView
            android:id="@+id/minimal_short_address_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="HXR7+MCV, MGR Nagar"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle Full Address -->
    <TextView
        android:id="@+id/minimal_full_address_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="Anna Nagar, Virudhunagar, Tamil Nadu, India"
        android:textColor="#E0E0E0"
        android:textSize="10sp" />

    <!-- Lat / Long Coordinates -->
    <TextView
        android:id="@+id/minimal_lat_long_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="Lat 9.591818° N   Long 77.963776° E"
        android:textColor="#B0BEC5"
        android:textSize="9sp" />

    <!-- Subtle Minimalist Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.75dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="7dp"
        android:background="#26FFFFFF" />

    <!-- Clean Horizontal Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_stamp_calendar"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/minimal_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="12 Sep 2026"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="|"
            android:textColor="#50FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/minimal_day_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Saturday"
            android:textColor="#D0D7DE"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="|"
            android:textColor="#50FFFFFF"
            android:textSize="9sp" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_stamp_clock"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/minimal_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="07:44:54 PM"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/minimal_altitude_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Alt 14.7m"
            android:textColor="#90CAF9"
            android:textSize="8.5sp" />
    </LinearLayout>

</LinearLayout>
