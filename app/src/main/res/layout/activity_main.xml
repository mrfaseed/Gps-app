<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout_activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Edge-to-Edge Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Touch-to-Focus View -->
    <com.example.gpsmapcameraapp.focusview.FocusView
        android:id="@+id/focusView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Countdown Animations -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/three_to_one_animation_view"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/myanimation" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/five_to_one_animation_view"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/fivesecondtimeranimation" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/progress_bar_animation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/progressbaranimation" />

    <!-- Sleek Top Controls Bar -->
    <LinearLayout
        android:id="@+id/linear_layout_main_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@drawable/bg_top_bar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Flash Button -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_glass">

            <ImageView
                android:id="@+id/flash_light_icon_main_activity"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/flash_light_icon_main_activity"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/flash_light_on_icon_main_activity"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/flash_on_icon"
                android:visibility="invisible"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Live GPS Status Pill -->
        <LinearLayout
            android:id="@+id/gps_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_gps_pill"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/gps_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_gps_dot" />

            <TextView
                android:id="@+id/gps_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="GPS Active"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Settings / Options Button -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_glass">

            <ImageView
                android:id="@+id/options_icon_main_activity"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/options_icon_main_activity"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

    <!-- Options Quick Settings Dropdown Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_options_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="20dp"
        android:visibility="invisible"
        app:cardBackgroundColor="#CC141414"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Timer Item -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/timer_off_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/timer_off_icon"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/timer_off_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/timer_off"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Focus Item -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/focus_manual_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/focus_manual_icon"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/focus_manual_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/focus_manual"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/focus_auto_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_auto"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Sound Item -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sound_off_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/sound_off_icon"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/sound_off_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sound_off"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- White Balance Item -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/white_balance_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/white_balance_icon"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/white_balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/white_balance"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ======================================================== -->
    <!-- FLOATING TRANSPARENT GLASSMORPHIC LOCATION STAMP HUD     -->
    <!-- ======================================================== -->
    <!-- Mini Map Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/map_card_view"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#59000000"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/card_view_main_activity"
        app:layout_constraintStart_toStartOf="parent">

        <fragment
            android:id="@+id/map_fragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Subtle frosted glass border overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card_stroke" />

    </androidx.cardview.widget.CardView>

    <!-- Location Details Glass Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/location_details_card_view"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/card_view_main_activity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/map_card_view">

        <!-- Outer border overlay for glass effect -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <!-- City / Address -->
            <TextView
                android:id="@+id/city_country_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Acquiring Location..."
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Lat / Long Coordinates -->
            <TextView
                android:id="@+id/long_lat_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Lat -- Long --"
                android:textColor="#E0E0E0"
                android:textSize="8.5sp" />

            <!-- Telemetry Row (Altitude, Accuracy, Timezone) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/altitude_icon_main"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/altitude_icon"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/altitude_tv_main_template"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#CCCCCC"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/accuracy_icon_main"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/accuracy_icon"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/accuracy_tv_template_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#CCCCCC"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/time_zone_tv_main_template"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#CCCCCC"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Date & Time -->
            <TextView
                android:id="@+id/date_day_time_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="Date &amp; Time"
                android:textColor="#CCCCCC"
                android:textSize="8sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Branding Footer -->
            <TextView
                android:id="@+id/captured_by_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Built by : Simatrix GPS Camera"
                android:textColor="#88FFFFFF"
                android:textSize="7.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Retained IDs for feature compatibility (kept gone/invisible) -->
        <ImageView
            android:id="@+id/cloudy_icon_main"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/weather_tv_main_template_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/plus_code_tv_main_location_details_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/wind_icon_main"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wind_tv_main_template"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pressure_icon_main"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pressure_tv_main_template"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>

    <!-- ======================================================== -->
    <!-- MODERN BOTTOM SHUTTER DECK                               -->
    <!-- ======================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_main_activity"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        app:cardBackgroundColor="#00000000"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Translucent gradient backing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_deck_gradient" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="10dp">

            <!-- Top Row: Quick Utility Buttons -->
            <LinearLayout
                android:id="@+id/quick_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Map Data Selector -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/map_data_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/map_data_icon"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/map_data_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/map_data"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Folder / Site Selector -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/default_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/default_icon"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/default_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/default_1"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Template Selector -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/template_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/template_icon"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/template_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/template"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Row: Gallery Preview, Shutter Button, Camera Switch -->

            <!-- Left: Gallery Preview Thumbnail -->
            <androidx.cardview.widget.CardView
                android:id="@+id/gallery_preview_card"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quick_actions_row">

                <ImageView
                    android:id="@+id/collection_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/collection_icon" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/collection_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/collection"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Center: Shutter Button -->
            <ImageView
                android:id="@+id/image_capture_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_shutter_ring"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quick_actions_row" />

            <!-- Right: Camera Switch Flip Button -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_circle_glass"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quick_actions_row">

                <ImageView
                    android:id="@+id/camera_change_icon_main_activity"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/camera_change_icon_main_activity"
                    app:tint="@color/white" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Horizontal Effects ScrollView (Hidden by default) -->
    <HorizontalScrollView
        android:id="@+id/horizontal_scroll_view_main"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#E6101010"
        android:scrollbars="none"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/effectsViewsLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/horizontal_scroll_view_main_cross_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:src="@drawable/horizontal_scroll_view_cross_icon" />

            <ImageView
                android:id="@+id/auto_effect_icon"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:src="@drawable/auto_effect_icon" />

            <ImageView
                android:id="@+id/manual_effect_icon"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:src="@drawable/manual_effect_icon" />

            <ImageView
                android:id="@+id/incandescent_effect_icon"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:src="@drawable/incandescent_effect_icon" />

            <ImageView
                android:id="@+id/flourescent_effect_icon"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:src="@drawable/flourescent_effect_icon" />

            <ImageView
